#!/usr/bin/env python3
"""The deterministic gate: does the job's branch pass the repo's checks?

Usage:
  gate <job-id>            write round-N/checks.md; exit 0 on PASS, 1 on FAIL, 3 on INCONCLUSIVE
  gate <job-id> --merge    same, as round-N/merge-checks.md (job merge runs it)
  gate --hook              builder SubagentStop hook: run the checks once, exit 2 on failure

The gate runs the main checkout's factory/checks.sh inside the job's worktree,
so a branch can't change the checks it is judged by. It also fails when the
branch modifies or deletes a file matching config.json `protected_paths`
(fnmatch patterns, where `*` also matches `/`, matched case-insensitively).
Adding new files is fine, except under `protected_trees`, where an addition
(or a rename into the tree) fails too.

Every commit of the branch must carry the trailers Factory-Job (this job),
Factory-Agent (an agent of .claude/agents/), Factory-Model (a model priced in
config.json) and Factory-Version (<factory/VERSION>+config.<12 hex>), once
each, in its last paragraph (spec §9). Only a merge commit may name the script
`job` as its agent, with Factory-Model `none`: job merge's sync with the base.
A commit without them fails the gate.

checks.sh exit 75 (EX_TEMPFAIL: a tool is unavailable, a test is flaky), or a
checks command that can't run at all (126, 127), gives INCONCLUSIVE: not a
failure, the job reruns the gate once, then escalates (spec §6). A protected
path change is a FAIL whatever the checks say.

Each verdict appends a line to factory/jobs/<job-id>/trace.jsonl: the gate's
command, the checks command and its directory, exit codes, verdict and the
commit checked (spec §7.2).
"""

import fnmatch
import json
import re
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
FACTORY = REPO / "factory"
CONFIG = json.loads((FACTORY / "config.json").read_text())
CHECKS = FACTORY / "checks.sh"
TAIL = 80
INCONCLUSIVE_EXITS = {75, 126, 127}
EXIT_CODES = {"PASS": 0, "FAIL": 1, "INCONCLUSIVE": 3}


def die(msg):
    print(f"gate: {msg}", file=sys.stderr)
    sys.exit(2)


def git(worktree, *args):
    res = subprocess.run(["git", *args], cwd=worktree, capture_output=True, text=True)
    if res.returncode != 0:
        die(f"`git {' '.join(args)}` failed: {res.stderr.strip()}")
    return res.stdout


def matches(path, patterns):
    # Case-insensitive: macOS maps `.Claude/x` onto `.claude/x`, git doesn't.
    return any(fnmatch.fnmatchcase(path.lower(), p.lower()) for p in patterns)


def protected_changes(worktree):
    """Files the branch changed under protected_paths (existing files: modified,
    deleted, renamed) or protected_trees (also added, or renamed into)."""
    # -z: NUL-delimited, unquoted paths. The text form quotes names with
    # non-ASCII or special characters, which would slip past the patterns.
    # --raw adds the file modes, so we can spot symlinks (120000) and submodules (160000).
    diff = git(worktree, "diff", "-z", "--raw", "-M", f"origin/{CONFIG['base_branch']}...HEAD")
    paths_cfg = CONFIG["protected_paths"]
    trees = CONFIG.get("protected_trees", [])
    tokens = diff.split("\0")
    hits = []
    i = 0
    while i < len(tokens) and tokens[i]:
        meta = tokens[i].lstrip(":").split(" ")  # old mode, new mode, old sha, new sha, status
        if len(meta) != 5:
            die(f"unexpected `git diff -z --raw` output near {tokens[i]!r}")
        new_mode, status = meta[1], meta[4]
        count = 2 if status[0] in "RC" else 1  # renames and copies carry old and new paths
        paths = tokens[i + 1 : i + 1 + count]
        i += 1 + count
        if len(paths) != count:
            die(f"unexpected `git diff -z --raw` output near {status!r}")
        old, new = paths[0], paths[-1]
        indirect = new_mode in ("120000", "160000")  # symlink or submodule
        hit = None
        if old.startswith('"') or new.startswith('"'):
            hit = old  # fail closed: a quoted path means we can't trust the match
        elif not status.startswith("A") and matches(old, paths_cfg + trees):
            hit = old
        elif matches(new, trees):
            hit = new
        elif indirect and (matches(new, paths_cfg) or matches(new.rstrip("/") + "/x", trees + paths_cfg)):
            # A symlink or submodule standing in for a protected file or directory.
            hit = f"{new} (symlink/submodule)"
        if hit:
            hits.append(f"{status[0]} {hit}")
    return hits


TRAILERS = ("Factory-Job", "Factory-Agent", "Factory-Model", "Factory-Version")
SCRIPT_AGENT = "job"
VERSION_FORMAT = re.compile(r"\d+\.\d+\.\d+\+config\.[0-9a-f]{12}")
AGENT_NAME = re.compile(r"[a-z][a-z0-9-]*")


def trailer_problems(worktree, job_id):
    """(commits checked, problems): one line per commit whose trailers are
    missing, repeated or not understood (spec §9)."""
    log = git(worktree, "log", "-z", "--format=%H %P%n%(trailers:only=true,unfold=true)",
              f"origin/{CONFIG['base_branch']}..HEAD")
    records = [r for r in log.split("\0") if r.strip()]
    problems = []
    for record in records:
        head, _, block = record.strip("\n").partition("\n")
        sha, *parents = head.split()
        found = {}
        for line in block.splitlines():
            key, sep, value = line.partition(":")
            if sep and key.strip() in TRAILERS:
                found.setdefault(key.strip(), []).append(value.strip())
        why = [f"missing {k}" for k in TRAILERS if k not in found]
        why += [f"{k} given twice" for k, v in found.items() if len(v) > 1]
        one = {k: v[0] for k, v in found.items()}
        if "Factory-Job" in one and one["Factory-Job"] != job_id:
            why.append(f"Factory-Job is {one['Factory-Job']!r}, not {job_id}")
        agent, model = one.get("Factory-Agent"), one.get("Factory-Model")
        if agent == SCRIPT_AGENT:
            if len(parents) < 2:
                why.append(f"Factory-Agent {SCRIPT_AGENT} is allowed only on a merge commit")
            if model is not None and model != "none":
                why.append(f"Factory-Model of a {SCRIPT_AGENT} merge must be none, not {model!r}")
        else:
            if agent is not None and not (AGENT_NAME.fullmatch(agent)
                                          and (REPO / ".claude" / "agents" / f"{agent}.md").is_file()):
                why.append(f"Factory-Agent {agent!r} isn't an agent of .claude/agents/")
            if model is not None and model not in CONFIG["prices_usd_per_mtok"]:
                why.append(f"Factory-Model {model!r} isn't a model of config.json prices_usd_per_mtok")
        version = one.get("Factory-Version")
        if version is not None and not VERSION_FORMAT.fullmatch(version):
            why.append(f"Factory-Version {version!r} isn't <version>+config.<12 hex>")
        if why:
            problems.append(f"{sha[:7]}: " + "; ".join(why))
    return len(records), problems


def checks_command():
    return ["bash", str(CHECKS)]


def run_checks(worktree):
    start = time.monotonic()
    res = subprocess.run(checks_command(), cwd=worktree, capture_output=True, text=True)
    return res.returncode, res.stdout + res.stderr, int(time.monotonic() - start)


def gate(job_id, merge):
    job = json.loads((FACTORY / "jobs" / job_id / "job.json").read_text())
    worktree = job["worktree"]
    if job["round"] < 1:
        die(f"{job_id} hasn't started a build round")
    round_dir = FACTORY / "jobs" / job_id / f"round-{job['round']}"
    commit = git(worktree, "rev-parse", "HEAD").strip()
    protected = protected_changes(worktree)
    traced, untraced = trailer_problems(worktree, job_id)
    code, log, seconds = run_checks(worktree)
    verdict = "PASS" if code == 0 and not protected and not untraced else "FAIL"
    if verdict == "FAIL" and not protected and not untraced and code in INCONCLUSIVE_EXITS:
        verdict = "INCONCLUSIVE"
    name = "merge-checks" if merge else "checks"
    (round_dir / f"{name}.log").write_text(log)
    tail = "\n".join(log.rstrip().splitlines()[-TAIL:])
    summary = [
        f"checks.sh {'passed' if code == 0 else f'failed with exit {code}'} in {seconds}s"
        + (" (inconclusive: a tool is unavailable or a test is flaky)" if verdict == "INCONCLUSIVE" else ""),
        f"Protected paths: {'changed: ' + ', '.join(protected) if protected else 'none changed'}",
        f"Trailers: {f'{len(untraced)} of {traced} commits untraced' if untraced else f'{traced} commits traced'}",
        f"Commit {commit[:7]}" + (", synced with the latest main before merging" if merge else ""),
    ]
    (round_dir / f"{name}.md").write_text(
        f"GATE: {verdict}\nCOMMIT: {commit}\n\n"
        "## Summary\n" + "\n".join(f"- {s}" for s in summary) + "\n\n"
        "## Protected paths\n"
        + ("\n".join(f"- {p}" for p in protected) if protected else "None changed.")
        + "\n\n## Trailers\n"
        + ("\n".join(f"- {t}" for t in untraced) if untraced else f"All {traced} commits carry them.")
        + f"\n\n## checks.sh\nExit {code} in {seconds}s. Last {TAIL} lines of {name}.log:\n\n```\n{tail}\n```\n"
    )
    exit_code = EXIT_CODES[verdict]
    trace = {
        "at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "control": "gate",
        "command": [sys.argv[0], *sys.argv[1:]],
        "checks_command": checks_command(),
        "cwd": str(worktree),
        "commit": commit,
        "round": job["round"],
        "merge": merge,
        "checks_exit": code,
        "protected": protected,
        "trailers": untraced,
        "verdict": verdict,
        "exit": exit_code,
    }
    with open(FACTORY / "jobs" / job_id / "trace.jsonl", "a") as f:
        f.write(json.dumps(trace) + "\n")
    print(f"GATE: {verdict} ({job_id} round {job['round']}, checks.sh exit {code} in {seconds}s"
          + (f", protected paths changed: {', '.join(protected)}" if protected else "")
          + (f", {len(untraced)} commits without valid trailers" if untraced else "") + ")")
    sys.exit(exit_code)


def hook():
    event = json.load(sys.stdin)
    if event.get("stop_hook_active"):
        sys.exit(0)  # one nudge per stop; the gate decides
    with open(Path(event["agent_transcript_path"]).expanduser()) as f:
        content = json.loads(f.readline())["message"]["content"]
    prompt = content if isinstance(content, str) else " ".join(b.get("text", "") for b in content)
    job_id = prompt.split("Job: ", 1)[1].split(".", 1)[0]
    job = json.loads((FACTORY / "jobs" / job_id / "job.json").read_text())
    code, log, _ = run_checks(job["worktree"])
    if code != 0:
        tail = "\n".join(log.rstrip().splitlines()[-40:])
        print(f"factory/checks.sh fails in your worktree (exit {code}). The gate will reject this "
              f"build. Fix it, or write STATUS: BLOCKED in build.md if you can't.\n\n{tail}",
              file=sys.stderr)
        sys.exit(2)


def main(argv):
    if argv == ["--hook"]:
        hook()
    elif len(argv) == 1 and not argv[0].startswith("-"):
        gate(argv[0], merge=False)
    elif len(argv) == 2 and argv[1] == "--merge":
        gate(argv[0], merge=True)
    else:
        die(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])
