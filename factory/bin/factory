#!/usr/bin/env python3
"""factory: one entry point for the factory's commands.

Usage:
  factory doctor [--base BRANCH]          prerequisites (spec §11.1)
  factory discover [options]              survey and questions; writes factory/answers.json (§11.2)
  factory install [--dry-run] [options]   applies the plan (§11.3)
  factory uninstall [--dry-run]           removes what install posed, from its journal (§11.3)
  factory verify [--target DIR]           smoke test after install; the install succeeds only if it passes (§11.4)
  factory audit [--root DIR]              pins and agent tools (§8)

`factory <command> --help` gives each command's options.
"""

import os
import sys
from pathlib import Path

BIN = Path(__file__).resolve().parent
COMMANDS = {"doctor": ["doctor"], "audit": ["audit"],
            "discover": ["installer", "discover"], "install": ["installer", "install"],
            "uninstall": ["installer", "uninstall"], "verify": ["verify"]}


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(0 if sys.argv[1:2] in (["-h"], ["--help"]) else 2)
    script, *sub = COMMANDS[sys.argv[1]]
    path = str(BIN / script)
    os.execv(sys.executable, [sys.executable, "-B", path, *sub, *sys.argv[2:]])


if __name__ == "__main__":
    main()
