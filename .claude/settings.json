{
  "permissions": {
    "deny": [
      "Read(**/.env*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p8)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.crt)",
      "Read(**/*.cer)",
      "Read(**/*.der)",
      "Read(**/id_rsa*)",
      "Read(**/id_dsa*)",
      "Read(**/id_ecdsa*)",
      "Read(**/id_ed25519*)",
      "Read(//**/.env*)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.p8)",
      "Read(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Read(//**/*.jks)",
      "Read(//**/*.keystore)",
      "Read(//**/*.crt)",
      "Read(//**/*.cer)",
      "Read(//**/*.der)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_dsa*)",
      "Read(//**/id_ecdsa*)",
      "Read(//**/id_ed25519*)",
      "Edit(**/.env*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p8)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/*.jks)",
      "Edit(**/*.keystore)",
      "Edit(**/*.crt)",
      "Edit(**/*.cer)",
      "Edit(**/*.der)",
      "Edit(**/id_rsa*)",
      "Edit(**/id_dsa*)",
      "Edit(**/id_ecdsa*)",
      "Edit(**/id_ed25519*)",
      "Edit(//**/.env*)",
      "Edit(//**/*.pem)",
      "Edit(//**/*.key)",
      "Edit(//**/*.p8)",
      "Edit(//**/*.p12)",
      "Edit(//**/*.pfx)",
      "Edit(//**/*.jks)",
      "Edit(//**/*.keystore)",
      "Edit(//**/*.crt)",
      "Edit(//**/*.cer)",
      "Edit(//**/*.der)",
      "Edit(//**/id_rsa*)",
      "Edit(//**/id_dsa*)",
      "Edit(//**/id_ecdsa*)",
      "Edit(//**/id_ed25519*)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
